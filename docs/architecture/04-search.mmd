%%{init: {"theme":"base","themeVariables":{"background":"#0b1220","primaryColor":"#172554","primaryTextColor":"#ffffff","primaryBorderColor":"#93c5fd","secondaryColor":"#163329","secondaryTextColor":"#ffffff","tertiaryColor":"#292038","tertiaryTextColor":"#ffffff","lineColor":"#cbd5e1","textColor":"#ffffff","edgeLabelBackground":"#0b1220","clusterBkg":"#111827","clusterBorder":"#64748b","fontFamily":"Arial","fontSize":"16px"},"flowchart":{"htmlLabels":false,"curve":"linear"}}}%%
flowchart TB
    BASE["Frozen credible baseline<br/>Contract, platform, measurement boundary"]:::store
    SPACE["Finite candidate space<br/>Widths, guard factoring, logic mapping"]:::main
    GEN["Deterministic enumerator first<br/>Optional solver or learned proposal later"]:::main
    OBL["Transformation obligations<br/>Range, ordering, state and timing equivalence"]:::check
    BAD["Candidate rejected<br/>Counterexample, timeout or invalid assumptions"]:::warn
    EST["Estimate only<br/>IR cost or synthesis proxy"]:::warn
    SHORT["Budgeted shortlist<br/>No estimated result labeled measured"]:::main
    PHY["Backend qualification<br/>Correctness plus exact P&R or CPU run"]:::check
    COMP["Comparison gate<br/>Same semantics and compatible controls"]:::check
    FRONT["Measured Pareto frontier<br/>Retain tradeoffs and uncertainty"]:::store
    LOG["Search ledger<br/>Seeds, transforms, failures, resource budget"]:::store
    BASE --> SPACE --> GEN --> OBL
    OBL -->|required result established| EST --> SHORT --> PHY --> COMP --> FRONT
    OBL -->|failure or unresolved| BAD
    BASE --> COMP
    GEN & BAD & PHY & FRONT --> LOG
    FRONT -->|stop at declared budget| GEN

classDef main fill:#172554,stroke:#93c5fd,color:#ffffff,stroke-width:2px;
classDef check fill:#163329,stroke:#6ee7b7,color:#ffffff,stroke-width:2px;
classDef warn fill:#422718,stroke:#fdba74,color:#ffffff,stroke-width:2px;
classDef future fill:#292038,stroke:#c4b5fd,color:#ffffff,stroke-width:2px;
classDef store fill:#1e293b,stroke:#cbd5e1,color:#ffffff,stroke-width:2px;
linkStyle default stroke:#cbd5e1,stroke-width:2px;
