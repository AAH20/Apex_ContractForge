%%{init: {"theme":"base","themeVariables":{"background":"#0b1220","primaryColor":"#172554","primaryTextColor":"#ffffff","primaryBorderColor":"#93c5fd","secondaryColor":"#163329","secondaryTextColor":"#ffffff","tertiaryColor":"#292038","tertiaryTextColor":"#ffffff","lineColor":"#cbd5e1","textColor":"#ffffff","edgeLabelBackground":"#0b1220","clusterBkg":"#111827","clusterBorder":"#64748b","fontFamily":"Arial","fontSize":"16px"},"flowchart":{"htmlLabels":false,"curve":"linear"}}}%%
flowchart TB
    IN["Normalized event and explicit time<br/>Priority arbitration before transition"]:::main
    AUTH["Active authority and epoch<br/>Input accepted only on handshake"]:::check
    VALID["Frame, sequence and field validation"]:::check
    GUARD["Strategy and risk guards<br/>Rate, exposure, ID, ledger and output space"]:::check
    REJECT["Recorded rejection<br/>No order reservation or output"]:::warn
    COMMIT["Atomic commit<br/>Reserve ID, quantity, rate, ledger and output"]:::main
    WAIT["Reserved output<br/>Stable ID and payload while stalled"]:::main
    TX["Defined irreversible TX-commit handshake<br/>Mark ledger entry committed"]:::main
    PENDING["Committed obligation<br/>Retain exposure until valid completion"]:::store
    TERM["Terminal event validation<br/>Matching committed ID and epoch"]:::check
    RETIRE["Retire once<br/>Release quantity and ledger entry"]:::main
    FAULT["Hold new admissions<br/>Preserve obligations and honor TX policy"]:::warn
    REC["Reconciliation and activation<br/>Quiescent state, newer epoch, valid config"]:::check
    IN --> AUTH --> VALID --> GUARD
    GUARD -->|passes| COMMIT --> WAIT
    GUARD -->|fails| REJECT
    WAIT -->|ready is low| WAIT
    WAIT -->|TX commit condition| TX --> PENDING
    IN -->|terminal event priority| TERM
    PENDING --> TERM
    TERM -->|valid completion| RETIRE
    TERM -->|duplicate or unmatched| REJECT
    VALID -->|gap or corruption| FAULT
    AUTH -->|reset or epoch fault| FAULT
    FAULT --> REC -->|all conditions satisfied| AUTH
    FAULT -->|already committed completions remain valid| TERM

classDef main fill:#172554,stroke:#93c5fd,color:#ffffff,stroke-width:2px;
classDef check fill:#163329,stroke:#6ee7b7,color:#ffffff,stroke-width:2px;
classDef warn fill:#422718,stroke:#fdba74,color:#ffffff,stroke-width:2px;
classDef future fill:#292038,stroke:#c4b5fd,color:#ffffff,stroke-width:2px;
classDef store fill:#1e293b,stroke:#cbd5e1,color:#ffffff,stroke-width:2px;
linkStyle default stroke:#cbd5e1,stroke-width:2px;
