flowchart TB
    S["Frozen contract<br/>Workload + faults + time semantics"]:::main
    P["Parser and semantic checker<br/>Types, bounds, effects, priority"]:::check
    I["Typed transition IR<br/>Pure DAG + ordered state commits"]:::main
    O["Legal transform search<br/>Proof obligations per candidate"]:::main
    CPU["C++ backend<br/>Single ordered executor"]:::main
    RTL["SystemVerilog backend<br/>Fixed commit schedule in v0"]:::main
    REF["Independent manual oracle<br/>Different state representation"]:::check
    V["Qualification gates<br/>Differential, formal, mutations"]:::check
    REJ["Rejected candidate<br/>Counterexample or unresolved proof"]:::warn
    H["Platform runner<br/>CPU benchmark or FPGA P&R and replay"]:::main
    M["Compatible measured frontier<br/>Latency, throughput, area, energy"]:::check
    A["Atlas export<br/>Raw artifacts and bounded claims"]:::store
    S --> P --> I --> O
    O --> CPU
    O --> RTL
    S --> REF
    CPU --> V
    RTL --> V
    REF --> V
    V -->|required checks pass| H
    V -->|failure or unknown required result| REJ
    REJ -->|shrink and preserve regression| O
    H --> M --> A
    M -->|measured feedback with search budget| O

classDef main fill:#172554,stroke:#93c5fd,color:#ffffff,stroke-width:2px;
classDef check fill:#163329,stroke:#6ee7b7,color:#ffffff,stroke-width:2px;
classDef warn fill:#422718,stroke:#fdba74,color:#ffffff,stroke-width:2px;
classDef future fill:#292038,stroke:#c4b5fd,color:#ffffff,stroke-width:2px;
classDef store fill:#1e293b,stroke:#cbd5e1,color:#ffffff,stroke-width:2px;
